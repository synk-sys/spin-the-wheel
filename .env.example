# ---------------------------------------------------------------------------
# DevFest Toronto 2026: Spin the Wheel — environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Data backend: "firestore" (required for the live event) or "memory" (local demo/tests).
DATA_BACKEND=memory
# Where the memory backend persists locally (empty = don't persist).
# MEMORY_STORE_FILE=.data/raffle-store.json

# Comma-separated organizer emails allowed into the admin dashboard.
# Alternatively/additionally grant the Firebase custom claim {"organizer": true}.
ORGANIZER_EMAILS=organizer@example.com

# Local-only login without Google (ignored when NODE_ENV=production).
AUTH_MODE=dev
# Optional: stable secret for dev sessions (otherwise random per server start).
# DEV_SESSION_SECRET=

# --- Firebase web app config (public; from Firebase console > Project settings > Your apps) ---
# Required for Google sign-in and the projector's real-time listener.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# --- Firebase Admin (server) ---
# On App Hosting, credentials come from the backend's service account automatically.
# Locally, EITHER point GOOGLE_APPLICATION_CREDENTIALS at a key file OR paste the JSON below.
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: force the projector to poll /api/display instead of using Firestore listeners.
# NEXT_PUBLIC_DISPLAY_SYNC=poll

# Optional: replace the center-of-wheel / header logo (https URL or /public path).
# NEXT_PUBLIC_BRAND_LOGO_URL=/branding/devfest-toronto-2026.svg
